# API-Football provider (backend only)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io
API_FOOTBALL_HOST=v3.football.api-sports.io

# CORS origins (comma-separated)
# Defaults are safe local origins + production placeholder.
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080,https://YOUR_FRONTEND_DOMAIN_HERE

# Uvicorn options (optional)
HOST=127.0.0.1
PORT=8000
